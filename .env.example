# Cognito auth config consumed by the Vite build (import.meta.env.VITE_*).
# In CI and scripts/deploy-snapshot.sh these are populated automatically from
# Terraform outputs. Copy this file to .env.local only for local `npm run dev`.

# OIDC issuer/authority — Terraform output: cognito_authority
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-north-1.amazonaws.com/<user-pool-id>

# App client ID — Terraform output: cognito_user_pool_client_id
VITE_COGNITO_CLIENT_ID=<app-client-id>

# Hosted UI domain (used for logout) — Terraform output: cognito_hosted_ui_domain
VITE_COGNITO_HOSTED_UI=https://wine-tracker-auth.auth.eu-north-1.amazoncognito.com
