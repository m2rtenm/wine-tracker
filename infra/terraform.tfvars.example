# Copy to terraform.tfvars (gitignored) and fill in before `terraform apply`.

# Google OAuth 2.0 Web client credentials (Google Cloud Console).
google_client_id     = "xxxxxxxx.apps.googleusercontent.com"
google_client_secret = "GOCSPX-xxxxxxxxxxxxxxxx"

# Emails permitted to sign in. Anyone else is rejected at sign-up.
allowed_emails = [
  "member1@gmail.com",
  "member2@gmail.com",
]

# Optional: override if the default Hosted UI domain prefix is taken.
# cognito_domain_prefix = "wine-tracker-auth"
